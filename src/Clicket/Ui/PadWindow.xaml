<ui:FloatingWindow x:Class="Clicket.Ui.PadWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Clicket.Ui"
                   Title="Clicket">
    <Grid Margin="{StaticResource Space.ShadowRoom}" Width="{StaticResource Size.PadWidth}">
        <Border Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Lg}" Effect="{StaticResource Elevation.Popup}" />
        <StackPanel Margin="8">
            <Grid x:Name="DragArea" Background="Transparent" Cursor="SizeAll" Height="{StaticResource Size.Control.Sm}" ToolTip="{ui:Loc PadTip}">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="Logo" Width="14" Height="14" />
                    <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc Pad}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource Button.Icon.Sm}" HorizontalAlignment="Right" ui:UiProps.Icon="{StaticResource Glyph.Close}" ToolTip="{ui:Loc Close}" Click="OnClose" />
            </Grid>
            <ItemsControl x:Name="Items" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:MacroItem}">
                        <Button x:Name="Run" Style="{StaticResource Button.Secondary}" Background="{StaticResource Brush.Surface3}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Height="{StaticResource Size.Control.Lg}" Margin="0,0,0,4" Padding="12,0" Click="OnRun" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Name" Style="{StaticResource Text.Body}" Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Glyph" Grid.Column="1" Style="{StaticResource Text.Icon}" FontSize="12" Text="{StaticResource Glyph.Play}" Margin="8,0,0,0" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="Run" Property="Background" Value="{StaticResource Brush.Accent.Soft}" />
                                <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Glyph.Stop}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="Empty" Style="{StaticResource Text.Paragraph}" FontSize="{StaticResource Type.Caption}" Text="{ui:Loc PadEmpty}" Margin="6,4,6,6" />
        </StackPanel>
    </Grid>
</ui:FloatingWindow>

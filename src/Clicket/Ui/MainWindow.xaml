<Window x:Class="Clicket.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Clicket.Ui"
        Title="Clicket" Width="1180" Height="740" MinWidth="960" MinHeight="600"
        Background="{StaticResource Brush.Canvas}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" FontFamily="{StaticResource Font.Text}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Library row: name, hotkey chip, step count; a green dot pulses while the macro plays. -->
        <DataTemplate x:Key="MacroRow" DataType="{x:Type ui:MacroItem}">
            <Grid Height="{StaticResource Size.LibraryRow}" Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Name}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding HotkeyText}" x:Name="HotkeyLabel" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text=" · " />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Summary}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{StaticResource Glyph.Pad}" Foreground="{StaticResource Brush.Text.Tertiary}"
                               Margin="0,0,8,0" Visibility="{Binding OnPad, Converter={StaticResource Visible}}" ToolTip="{ui:Loc OnPad}" />
                    <Ellipse x:Name="Dot" Width="{StaticResource Size.Dot}" Height="{StaticResource Size.Dot}" Fill="{StaticResource Brush.Accent}"
                             Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" ToolTip="{ui:Loc Running}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="Pulse">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="30">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="{StaticResource Motion.Pulse}" EasingFunction="{StaticResource Motion.InOut}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulse" />
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasHotkey}" Value="True">
                    <Setter TargetName="HotkeyLabel" Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="LibraryItem" TargetType="ListBoxItem" BasedOn="{StaticResource ListItem.Row}">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Visible}}" />
        </Style>

        <!-- Timeline row: number, family glyph, text, and a bar whose length is the step's share of time. -->
        <DataTemplate x:Key="StepRow" DataType="{x:Type ui:StepItem}">
            <Grid Height="{StaticResource Size.Row}" Margin="{StaticResource Space.Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Numeral}" Text="{Binding Number}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                <Grid Grid.Column="1" Margin="{Binding Indent}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="{StaticResource Size.Glyph}" Height="{StaticResource Size.Glyph}" CornerRadius="{StaticResource Radius.Sm}" Background="{Binding HueSoft}">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Text="{Binding Glyph}" Foreground="{Binding Hue}" />
                    </Border>
                    <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Icon}" FontSize="12" Text="{StaticResource Glyph.Warning}" Foreground="{StaticResource Brush.Warning}" Margin="8,0,0,0"
                                   Visibility="{Binding IsError, Converter={StaticResource Visible}}" />
                        <!-- One line that trims as a whole: title, then the detail and the note in a quieter tone. -->
                        <TextBlock x:Name="Title" Style="{StaticResource Text.Body}">
                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding DetailText, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="{StaticResource Type.Caption}" /><Run Text="{Binding NoteText, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="{StaticResource Type.Caption}" FontStyle="Italic" />
                        </TextBlock>
                    </DockPanel>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="{StaticResource Size.TimingBar}" VerticalAlignment="Center">
                        <Border Height="{StaticResource Size.TimingBarHeight}" CornerRadius="{StaticResource Radius.Bar}" Background="{Binding Hue}"
                                Width="{Binding BarWidth}" HorizontalAlignment="Left" Opacity="0.85" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Numeral}" Text="{Binding Timing}" Width="84" TextAlignment="Right" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLoopMarker}" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.Cat.Loop}" />
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Title bar ===== -->
        <Grid Grid.Row="0" Background="{StaticResource Brush.Canvas}">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="Logo" Width="18" Height="18" />
                <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Clicket" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton x:Name="PadToggle" Style="{StaticResource Toggle.Icon}" ui:UiProps.Icon="{StaticResource Glyph.Pad}" ToolTip="{ui:Loc Pad}"
                              WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" Click="OnPadToggle" />
                <Button Style="{StaticResource Button.Icon}" ui:UiProps.Icon="{StaticResource Glyph.Settings}" ToolTip="{ui:Loc Settings}"
                        WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" Margin="2,0,10,0" Click="OnOpenSettings" />
                <Button Style="{StaticResource Button.Caption}" Content="{StaticResource Glyph.Minimize}" ToolTip="{ui:Loc Minimize}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Content="{StaticResource Glyph.Maximize}" ToolTip="{ui:Loc Maximize}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximize" />
                <Button Style="{StaticResource Button.Caption.Close}" Content="{StaticResource Glyph.Close}" ToolTip="{ui:Loc Close}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" />
            </StackPanel>
        </Grid>

        <!-- ===== Work area ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="316" />
            </Grid.ColumnDefinitions>

            <!-- Library -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Surface1}" CornerRadius="0,12,0,0">
                <DockPanel Margin="12,14,12,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBox x:Name="SearchBox" ui:UiProps.Icon="{StaticResource Glyph.Search}" ui:UiProps.Placeholder="{ui:Loc SearchMacros}" TextChanged="OnSearchChanged" />
                        <Grid Margin="{StaticResource Space.Gap.Top}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Button.Secondary}" HorizontalAlignment="Stretch" ui:UiProps.Icon="{StaticResource Glyph.Add}" Content="{ui:Loc NewShort}" ToolTip="{ui:Loc NewMacro}" Click="OnNewMacro" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Record}" ui:UiProps.Icon="{StaticResource Glyph.Record}" Content="{ui:Loc RecordNew}" ToolTip="{ui:Loc RecordNewTip}" Click="OnRecordNew" />
                            <Button Grid.Column="4" Style="{StaticResource Button.Icon}" ui:UiProps.Icon="{StaticResource Glyph.Import}" ToolTip="{ui:Loc ImportTip}" Click="OnImport" />
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc Library}" Margin="4,18,0,8" />
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="LibraryList" ItemTemplate="{StaticResource MacroRow}" ItemContainerStyle="{StaticResource LibraryItem}" SelectionChanged="OnLibrarySelection"
                                 VirtualizingPanel.IsVirtualizing="True" />
                        <StackPanel x:Name="LibraryEmpty" VerticalAlignment="Top" Margin="4,8,4,0" Visibility="Collapsed">
                            <TextBlock x:Name="LibraryEmptyTitle" Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" TextTrimming="None" />
                            <TextBlock x:Name="LibraryEmptyBody" Style="{StaticResource Text.Paragraph}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Editor -->
            <Grid Grid.Column="1" x:Name="EditorArea">
                <Grid x:Name="Editor" Margin="{StaticResource Space.Page}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Name and run controls -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Inline}" ui:UiProps.Placeholder="{ui:Loc MacroName}" Margin="-6,0,16,0" TextChanged="OnNameChanged" MaxLength="80" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PlayButton" Style="{StaticResource Button.Primary}" ui:UiProps.Icon="{StaticResource Glyph.Play}" Content="{ui:Loc Play}" ToolTip="{ui:Loc PlayTip}" Click="OnPlay" MinWidth="104" />
                            <Button x:Name="StopButton" Style="{StaticResource Button.Danger}" ui:UiProps.Icon="{StaticResource Glyph.Stop}" Content="{ui:Loc Stop}" Click="OnStop" MinWidth="104" Visibility="Collapsed" />
                            <Button x:Name="MoreButton" Style="{StaticResource Button.Icon}" ui:UiProps.Icon="{StaticResource Glyph.More}" ToolTip="{ui:Loc More}" Margin="6,0,0,0" Click="OnMore">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MoreMenu" Placement="Bottom">
                                        <MenuItem ui:UiProps.Icon="{StaticResource Glyph.Copy}" Header="{ui:Loc Duplicate}" Click="OnDuplicateMacro" />
                                        <MenuItem ui:UiProps.Icon="{StaticResource Glyph.Export}" Header="{ui:Loc Export}" Click="OnExportMacro" />
                                        <Separator />
                                        <MenuItem x:Name="DeleteMenuItem" Style="{StaticResource MenuItem.Danger}" ui:UiProps.Icon="{StaticResource Glyph.Delete}" Header="{ui:Loc Delete}" Click="OnDeleteMacro" StaysOpenOnClick="True" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Trigger settings -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,28,12">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc Hotkey}" Margin="0,0,0,6" />
                                <Grid Width="220">
                                    <ui:KeyCaptureBox x:Name="HotkeyBox" AllowMouse="True" />
                                    <Button x:Name="ClearHotkeyButton" Style="{StaticResource Button.Icon.Sm}" HorizontalAlignment="Right" Margin="0,0,3,0"
                                            ui:UiProps.Icon="{StaticResource Glyph.Close}" ToolTip="{ui:Loc ClearHotkey}" Click="OnClearHotkey" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc Mode}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Height="{StaticResource Size.Control}">
                                    <ui:Segmented x:Name="ModeSelector" Keys="ModeOnce,ModeRepeat,ModeWhileHeld,ModeToggle" TipKeys="ModeOnceTip,ModeRepeatTip,ModeWhileHeldTip,ModeToggleTip" VerticalAlignment="Center" />
                                    <StackPanel x:Name="RepeatPanel" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBox x:Name="RepeatBox" Width="64" TextChanged="OnRepeatChanged" />
                                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{ui:Loc Times}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="HotkeyMessage" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Warning}" Margin="0,0,0,10" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ui:Switch x:Name="EnabledSwitch" Style="{StaticResource Switch}" Click="OnEnabledChanged" Margin="0,0,32,0">
                                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{ui:Loc Enabled}" />
                                </ui:Switch>
                                <ui:Switch x:Name="PadSwitch" Style="{StaticResource Switch}" Click="OnPadChanged">
                                    <TextBlock Style="{StaticResource Text.Secondary}"  Text="{ui:Loc OnPad}" />
                                </ui:Switch>
                        </StackPanel>
                    </StackPanel>

                    <!-- Timeline -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource Brush.Surface1}" Margin="0,18,0,0" Padding="8,10,8,8">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="10,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Subtitle}" Text="{ui:Loc Steps}" />
                                    <TextBlock x:Name="StepsSummary" Style="{StaticResource Text.Caption}" Margin="12,2,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Record}" Height="{StaticResource Size.Control.Sm}" Padding="{StaticResource Space.ControlSm}" ui:UiProps.Icon="{StaticResource Glyph.Record}"
                                            Content="{ui:Loc RecordInto}" ToolTip="{ui:Loc RecordIntoTip}" Click="OnRecordInto" Margin="0,0,8,0" />
                                    <Button x:Name="WrapButton" Style="{StaticResource Button.Icon.Sm}" ui:UiProps.Icon="{StaticResource Glyph.Loop}" ToolTip="{ui:Loc WrapInLoop}" Click="OnWrapLoop" />
                                    <Button x:Name="UpButton" Style="{StaticResource Button.Icon.Sm}" ui:UiProps.Icon="{StaticResource Glyph.Up}" ToolTip="{ui:Loc MoveUp}" Click="OnMoveUp" />
                                    <Button x:Name="DownButton" Style="{StaticResource Button.Icon.Sm}" ui:UiProps.Icon="{StaticResource Glyph.Down}" ToolTip="{ui:Loc MoveDown}" Click="OnMoveDown" />
                                    <Button x:Name="DuplicateButton" Style="{StaticResource Button.Icon.Sm}" ui:UiProps.Icon="{StaticResource Glyph.Copy}" ToolTip="{ui:Loc DuplicateStep}" Click="OnDuplicateStep" />
                                    <Button x:Name="DeleteButton" Style="{StaticResource Button.Icon.Sm}" ui:UiProps.Icon="{StaticResource Glyph.Delete}" ToolTip="{ui:Loc DeleteStep}" Click="OnDeleteStep" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="LoopBanner" DockPanel.Dock="Top" Background="{StaticResource Brush.Warning.Soft}" CornerRadius="{StaticResource Radius.Md}" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource Glyph.Warning}" Foreground="{StaticResource Brush.Warning}" />
                                    <TextBlock x:Name="LoopBannerText" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Warning}" Margin="10,0,0,0" TextWrapping="Wrap" TextTrimming="None" />
                                </StackPanel>
                            </Border>
                            <Grid>
                                <ListBox x:Name="StepsList" ItemTemplate="{StaticResource StepRow}" ItemContainerStyle="{StaticResource ListItem.Row}" SelectionMode="Extended"
                                         SelectionChanged="OnStepSelection" PreviewKeyDown="OnStepsKeyDown"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" />
                                <StackPanel x:Name="StepsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="28" Text="{StaticResource Glyph.Keyboard}" Foreground="{StaticResource Brush.Text.Disabled}" />
                                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{ui:Loc EmptyStepsTitle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{ui:Loc EmptyStepsBody}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <StackPanel x:Name="NoMacro" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Image x:Name="NoMacroLogo" Width="64" Height="64" Opacity="0.9" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{ui:Loc NoMacroTitle}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{ui:Loc NoMacroBody}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Inspector -->
            <Border Grid.Column="2" Background="{StaticResource Brush.Surface1}" CornerRadius="12,0,0,0">
                <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" Padding="16,14,16,16">
                    <StackPanel x:Name="Inspector">
                        <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc Insert}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc InsertHint}" Margin="0,2,0,10" />
                        <UniformGrid x:Name="Tiles" Columns="4">
                            <UniformGrid.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Tile}">
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                </Style>
                            </UniformGrid.Resources>
                            <Button Tag="Key" ui:UiProps.Icon="{StaticResource Glyph.Key}" ui:UiProps.Accent="{StaticResource Brush.Cat.Key}" Content="{ui:Loc CatKey}" Click="OnInsert" />
                            <Button Tag="Mouse" ui:UiProps.Icon="{StaticResource Glyph.Mouse}" ui:UiProps.Accent="{StaticResource Brush.Cat.Mouse}" Content="{ui:Loc CatMouse}" Click="OnInsert" />
                            <Button Tag="Text" ui:UiProps.Icon="{StaticResource Glyph.Text}" ui:UiProps.Accent="{StaticResource Brush.Cat.Text}" Content="{ui:Loc CatText}" Click="OnInsert" />
                            <Button Tag="Delay" ui:UiProps.Icon="{StaticResource Glyph.Delay}" ui:UiProps.Accent="{StaticResource Brush.Cat.Delay}" Content="{ui:Loc CatDelay}" Click="OnInsert" />
                            <Button Tag="Loop" ui:UiProps.Icon="{StaticResource Glyph.Loop}" ui:UiProps.Accent="{StaticResource Brush.Cat.Loop}" Content="{ui:Loc CatLoop}" Click="OnInsert" />
                            <Button Tag="Command" ui:UiProps.Icon="{StaticResource Glyph.Command}" ui:UiProps.Accent="{StaticResource Brush.Cat.Command}" Content="{ui:Loc CatCommand}" Click="OnInsert" />
                            <Button Tag="Open" ui:UiProps.Icon="{StaticResource Glyph.Open}" ui:UiProps.Accent="{StaticResource Brush.Cat.Open}" Content="{ui:Loc CatOpen}" Click="OnInsert" />
                            <Button Tag="Script" ui:UiProps.Icon="{StaticResource Glyph.Script}" ui:UiProps.Accent="{StaticResource Brush.Cat.Script}" Content="{ui:Loc CatScript}" Click="OnInsert" />
                        </UniformGrid>

                        <ui:StepEditor x:Name="StepEditor" Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Toast ===== -->
        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Background="{StaticResource Brush.Surface5}"
                CornerRadius="{StaticResource Radius.Md}" Padding="14,9" Effect="{StaticResource Elevation.Popup}" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Style="{StaticResource Text.Body}" />
        </Border>

        <!-- ===== Settings overlay ===== -->
        <ui:SettingsPanel x:Name="Settings" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>

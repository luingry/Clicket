<Window x:Class="Clicket.Ui.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Clicket.Ui"
        Title="Clicket" SizeToContent="WidthAndHeight" ShowInTaskbar="False" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="Item" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Setter Property="Padding" Value="{StaticResource Space.MenuItem}" />
        </Style>
    </Window.Resources>
    <Grid Margin="{StaticResource Space.ShadowRoom}" MinWidth="{StaticResource Size.MenuMinWidth}">
        <Border CornerRadius="{StaticResource Radius.Lg}" Background="{StaticResource Brush.Surface4}" Effect="{StaticResource Elevation.Popup}" />
        <StackPanel Margin="{StaticResource Space.Menu}">
            <Button Style="{StaticResource Item}" ui:UiProps.Icon="{StaticResource Glyph.Open}" Content="{ui:Loc TrayOpen}" FontWeight="SemiBold" Click="OnOpen" />
            <Button x:Name="PadItem" Style="{StaticResource Item}" ui:UiProps.Icon="{StaticResource Glyph.Pad}" Click="OnPad" />
            <Button Style="{StaticResource Item}" ui:UiProps.Icon="{StaticResource Glyph.Stop}" Content="{ui:Loc TrayStopAll}" Click="OnStopAll" />
            <Button Style="{StaticResource Item}" ui:UiProps.Icon="{StaticResource Glyph.Settings}" Content="{ui:Loc Settings}" Click="OnSettings" />
            <Border Height="6" />
            <Button Style="{StaticResource Item}" ui:UiProps.Icon="{StaticResource Glyph.Close}" Content="{ui:Loc TrayExit}" Click="OnExit" />
        </StackPanel>
    </Grid>
</Window>

<ui:FloatingWindow x:Class="Clicket.Ui.RecordingBar"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Clicket.Ui"
                   Title="Clicket">
    <Grid Margin="{StaticResource Space.ShadowRoom}">
        <Border x:Name="Pill" Background="{StaticResource Brush.Surface3}" CornerRadius="{StaticResource Radius.Xl}" Effect="{StaticResource Elevation.Popup}" />
        <StackPanel Orientation="Horizontal" Margin="16,8,8,8">
            <Grid x:Name="DragArea" Background="Transparent" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource Brush.Record}" VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="30">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="{StaticResource Motion.Pulse}" EasingFunction="{StaticResource Motion.InOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{ui:Loc Recording}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Elapsed" Style="{StaticResource Text.Numeral}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="{StaticResource Type.Body}" Margin="12,0,0,0" VerticalAlignment="Center" Text="00:00" />
                    <TextBlock x:Name="Count" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Hint" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Button Style="{StaticResource Button.Record}" Height="{StaticResource Size.Control.Sm}" Padding="{StaticResource Space.ControlSm}" Margin="16,0,0,0"
                    ui:UiProps.Icon="{StaticResource Glyph.Stop}" Content="{ui:Loc Stop}" Click="OnStop" />
        </StackPanel>
    </Grid>
</ui:FloatingWindow>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SwissTechKnife module: a thin supervisor that runs Clicket in its own process (hosted mode), so the
    keyboard and mouse hooks never share the host's UI thread. scripts/pack-module.ps1 puts the app next to it.
  -->
  <PropertyGroup>
    <RootNamespace>Clicket.Module</RootNamespace>
    <AssemblyName>Clicket.Module</AssemblyName>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-only: the host provides the one shared copy at runtime. Refresh from a SwissTechKnife build. -->
    <Reference Include="SwissTechKnife.Sdk" HintPath="lib\SwissTechKnife.Sdk.dll" Private="false" />
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
